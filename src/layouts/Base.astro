---
import { SITE, NAV, EDITORIAL_UPDATED_AT } from '../consts';
import { url } from '../utils/url';
import '../styles/global.css';

interface Breadcrumb { name: string; href: string; }
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  headline?: string;
  breadcrumbs?: Breadcrumb[];
}
const { title, description = SITE.description, canonical, noindex: noindexProp = false, image, headline, breadcrumbs: suppliedBreadcrumbs } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
// Strip the .html extension (and trailing /index) that Astro.url.pathname carries under
// build.format:'file' — the sitemap and every internal link use the extensionless form,
// so the canonical must match it or GSC reports every URL as a duplicate with a mismatched
// canonical.
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const localPath = basePath && cleanPath.startsWith(`${basePath}/`) ? cleanPath.slice(basePath.length) : cleanPath === basePath ? '/' : cleanPath;
const siteURL = Astro.site ?? new URL(SITE.url);
const resolvedCanonical = new URL(canonical ?? cleanPath, siteURL).href;
// @astrojs/sitemap removes the root slash for build.format:'file'. Match its
// emitted URL byte-for-byte, as well as keeping extensionless child canonicals.
const canonicalURL = new URL(resolvedCanonical).pathname === '/' ? resolvedCanonical.replace(/\/$/, '') : resolvedCanonical;
const noindex = noindexProp || import.meta.env.PUBLIC_NOINDEX === 'true';
const ogImage = new URL(image ?? url('/og-default.png'), siteURL).href;
const imageAlt = `${SITE.name} — ${SITE.tagline}`;
const breadcrumbs = suppliedBreadcrumbs ?? (!noindex && localPath !== '/' ? [{ name: title ?? SITE.name, href: localPath }] : []);
const homeURL = new URL(url('/'), siteURL).href;
const isArticle = !noindex && headline && /^\/(?:guides|reviews|compare)\//.test(localPath);
const isApp = !noindex && headline && localPath.startsWith('/tools/');
const updatedLabel = new Date(EDITORIAL_UPDATED_AT).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Los_Angeles' });
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  '@id': `${homeURL}#organization`,
  url: homeURL,
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  '@id': `${homeURL}#website`,
  url: homeURL,
};
const breadcrumbLd = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(url(b.href), siteURL).href,
  })),
} : null;
const articleLd = isArticle ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalURL}#article`,
  mainEntityOfPage: canonicalURL,
  headline,
  dateModified: EDITORIAL_UPDATED_AT,
  author: { '@type': 'Organization', name: SITE.name, url: new URL(url('/about'), siteURL).href },
  publisher: { '@id': `${homeURL}#organization` },
} : null;
// These are free browser tools, not mobile apps. Without genuine user reviews
// they are not eligible for Google's software-app stars; never invent a rating.
const appLd = isApp ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${canonicalURL}#calculator`,
  name: headline,
  url: canonicalURL,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'JavaScript is needed for live results.',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href={url('/fonts/space-grotesk-latin.woff2')} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#0d1b26" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    {appLd && <script type="application/ld+json" set:html={JSON.stringify(appLd)} />}
    <!-- Cloudflare Web Analytics — cookieless, no personal data, no consent banner required -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "aff7ac4ac456478781ac996eb3f26a0a"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a href={url('/')} class="wordmark">Reef<span>Metric</span></a>
      <nav aria-label="Main">
        {NAV.map((item) => <a href={url(item.href)}>{item.label}</a>)}
      </nav>
    </header>
    <div class="disclosure-bar">
      Some links are paid links — if you buy through them we may earn a commission, at no extra cost to you. <a href={url('/disclosure')}>How this works</a>.
    </div>
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav class="breadcrumbs container" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a>
        {breadcrumbs.map((b, i) => (
          <>
            <span aria-hidden="true"> / </span>
            {i === breadcrumbs.length - 1 ? <span aria-current="page">{b.name}</span> : <a href={url(b.href)}>{b.name}</a>}
          </>
        ))}
      </nav>
    )}
    <main id="main-content">
      {isArticle && <p class="container" data-page-meta style="padding-top:16px;font-size:.8rem;color:var(--muted)">By <a href={url('/about')}>ReefMetric</a>. Page updated: <time datetime={EDITORIAL_UPDATED_AT}>{updatedLabel}</time>. Equipment data keeps the source dates shown below.</p>}
      {isApp && <p class="container" data-page-meta style="padding-top:16px;font-size:.8rem;color:var(--muted)">Free browser calculator. JavaScript is needed for live results. No account is required.</p>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wordmark-sm">ReefMetric</div>
      <p>{SITE.tagline}</p>
      <nav>
        <a href={url('/about')}>About</a>
        <a href={url('/how-we-rate')}>How We Rate</a>
        <a href={url('/disclosure')}>Affiliate Disclosure</a>
        <a href={url('/privacy')}>Privacy</a>
      </nav>
      <p class="fine">© 2026 ReefMetric. Independent and reader-supported. Qualifying purchases through approved affiliate links may earn a commission. Our rankings follow our published method.</p>
    </footer>
  </body>
</html>
