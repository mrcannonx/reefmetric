---
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { url } from '../../utils/url';
import { SITE } from '../../consts';
import { goHref, retailerName } from '../../data/affiliate-config';
import doserData from '../../data/dosers.json';

const slug = (d: { brand: string; model: string }) =>
  `${d.brand}-${d.model}`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

interface Doser {
  brand: string; model: string; priceUSD: number | null; heads: number; accuracy: string;
  app: string; reservoirNotes: string; knownIssues: string[]; riskFlag?: string;
  retailers?: string[]; source: string; specSource?: string; imageUrl?: string | null;
}
const data = doserData as any;
const dosers = data.dosers as Doser[];
const notStandalone = data.notStandalone as { brand: string; model: string; priceUSD: number | null; note: string; priceSource: string; specSource?: string }[];
const dataDate = data.generated as string;

const money = (n: number | null) => (n != null ? `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : 'Check price');
const buy = (d: { brand: string; model: string; retailers?: string[]; source?: string }) => goHref(d.retailers || [], `${d.brand} ${d.model} dosing pump`, d.source);
const buyGap = (d: { brand: string; model: string }) => goHref([], `${d.brand} ${d.model} dosing pump`);

interface Pick { badge: string; why: string; d: Doser; }
const byModel = (m: string) => dosers.find((d) => d.model === m)!;
const picks: Pick[] = [
  {
    badge: 'Two-additive starting point',
    why: `Two heads for two separate additives, controlled through ReefBeat without a separate aquarium controller. Check the current price before ordering.`,
    d: byModel('ReefDose 2'),
  },
  {
    badge: 'Best step-up',
    why: `Four heads rather than two, for keeping more additives on separate lines without a separate aquarium controller.`,
    d: byModel('ReefDose 4'),
  },
  {
    badge: 'Best for GHL owners',
    why: `A standalone four-head doser with Wi-Fi, LAN and USB connections. GHL provides GHL Connect, a web interface and myGHL; choose the connection that fits your setup.`,
    d: byModel('Doser 3 SA'),
  },
  {
    badge: 'Most channels',
    why: `Five pumps in total. The maker says two can serve water changes or continuous dosing; they are part of the five, not two extra heads. Confirm that the seller is quoting the Pro model.`,
    d: byModel('Dosetronic Pro'),
  },
];
const accuracyPick = byModel('Dosing Pump Pro X4');

const pageURL = new URL(url('/reviews/best-reef-dosing-pumps'), SITE.url).href;
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Reef Dosing Pumps',
  numberOfItems: dosers.length,
  itemListElement: dosers.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: `${d.brand} ${d.model}`, url: `${pageURL}#${slug(d)}` })),
};
const faqs = [
  {
    q: 'Do I need an existing controller to use a dosing pump?',
    a: `ReefDose, Doser 3 SA and Dosetronic provide standalone dosing control. Neptune's DOS QuietDrive requires an A2 or A3 Series Apex controller; GHL's EXT is an extension unit. Include the required controller, power connections, tubing and containers when comparing total installed cost.`,
  },
  {
    q: 'Can I use any of these to dose kalkwasser?',
    a: data.kalkwasserNotes,
  },
  {
    q: 'Is the Reef Factory X4 still safe to buy?',
    a: `Its maker lists ±0.01 mL dosing accuracy. That specification does not prove an installed dose or establish a fair accuracy ranking against other brands. As of October 25, 2026, the developer-provided Smart Reef Google Play listing names REEF FACTORY SP Z O O [ W UPADŁOŚCI ]. Current warranty fulfillment and future app or cloud support have not been verified. Get written support terms from your seller before ordering.`,
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const headline = "Best dosing pump for a reef tank: heads, cost & control";
---
<Base
  headline={headline}
  title="Best Dosing Pump for a Reef Tank (2026)"
  description="Compare reef dosing pumps by published accuracy, channels, cost, and controller needs. See which pumps work alone and which need extra hardware."
  breadcrumbs={[{ name: 'Reviews', href: '/reviews' }, { name: 'Best Reef Dosing Pumps', href: '/reviews/best-reef-dosing-pumps' }]}
>
  <section class="container tool-wrap prose">
    <p class="eyebrow" style="color:var(--brand-2)">Reviews · Dosing Pumps</p>
    <h1>{headline}</h1>
    <p class="lede-dark">For a reef tank dosing two separate additives, the {picks[0].d.brand} {picks[0].d.model} is our starting pick: {picks[0].d.heads} heads, standalone control, and {money(picks[0].d.priceUSD)} in the recorded dataset. Need four lines? The {picks[1].d.model} has {picks[1].d.heads} heads at {money(picks[1].d.priceUSD)}. Match the head count and controller needs to your routine before buying.</p>
    <h2 id="quick-answer">Which reef dosing pump should you choose?</h2>
    <p><strong>Two additives:</strong> start with ReefDose 2. <strong>More separate additives:</strong> compare ReefDose 4 and the standalone GHL Doser 3 SA. <strong>Already own an Apex:</strong> compare the DOS accessory below with the total cost of a standalone unit. Published accuracy is a specification, not proof of your dose after installation: calibrate with the tubing and liquid you will use.</p>
    <p>A dosing pump schedules liquid delivery; it does not decide what your tank needs. Use measured consumption and the <a href={url('/tools/reef-dosing-calculator')}>reef dosing calculator</a> for alkalinity, calcium, or magnesium. Read the <a href={url('/guides/carbon-dosing')}>carbon dosing guide</a> separately for nutrient export.</p>
    <Disclosure />
    <p class="rnote" style="margin-top:0">Recorded prices date from {dataDate}; they are not current quotes. Maker specifications were rechecked October 25, 2026 and are linked below. Availability and warranty fulfillment are not established by a working product page. Nobody pays for placement. <a href={url('/how-we-rate')}>Full methodology →</a></p>
  </section>

  <section class="container" style="padding-top:8px;padding-bottom:16px;">
    <h2>The picks</h2>
    <div class="results">
      {picks.map((p, idx) => (
        <div id={slug(p.d)} class={`rcard ${idx === 0 ? 'win' : ''}`}>
          {p.d.imageUrl && (
            <div class="rthumb">
              <img src={p.d.imageUrl} alt={`${p.d.brand} ${p.d.model}`} loading="lazy" decoding="async" width="64" height="64" onerror="this.parentElement.style.display='none'" />
            </div>
          )}
          <div class="rmain">
            <div class="rname">{p.d.brand} {p.d.model} <span class={idx === 0 ? 'pill-win' : 'rbadge'}>{p.badge}</span></div>
            <div class="rmeta">{p.why}</div>
            <div class="rmeta">{p.d.heads} heads · {p.d.accuracy} · {p.d.app}</div>
            <div class="rmeta"><a href={p.d.specSource || p.d.source}>Maker specifications</a> · Recorded price: {money(p.d.priceUSD)}{p.d.priceUSD === null ? ' (exact model quote needed)' : ' (historical)'}</div>
          </div>
          <div class="rflow"><span class="n">{p.d.heads}</span><br /><span class="u">heads</span></div>
          <div class="rbuy"><a class="aff" href={buy(p.d)} target="_blank" rel="sponsored nofollow noopener">Check price at {retailerName(p.d.retailers)} ↗ <small>(paid link)</small></a></div>
        </div>
      ))}
    </div>

    <h2 style="margin-top:32px;">Published accuracy is only part of the choice</h2>
    <div class="results">
      <div id={slug(accuracyPick)} class="rcard">
        {accuracyPick.imageUrl && (
          <div class="rthumb">
            <img src={accuracyPick.imageUrl} alt={`${accuracyPick.brand} ${accuracyPick.model}`} loading="lazy" decoding="async" width="64" height="64" onerror="this.parentElement.style.display='none'" />
          </div>
        )}
        <div class="rmain">
          <div class="rname">{accuracyPick.brand} {accuracyPick.model} <span class="rbadge" style="background:#fbeadd;color:#9a5a3a;">Check support terms</span></div>
          <div class="rmeta">The maker lists ±0.01 mL dosing accuracy. We have not verified common test conditions across these brands, so this is not an accuracy ranking. The developer-provided Smart Reef listing currently names “REEF FACTORY SP Z O O [ W UPADŁOŚCI ]”. Warranty fulfillment and future app or cloud support are unverified; ask the seller for current terms.</div>
          <div class="rmeta">{accuracyPick.heads} heads · {accuracyPick.accuracy} · {accuracyPick.app}</div>
          <div class="rmeta"><a href={accuracyPick.specSource}>Maker specifications</a> · <a href={data.dosers.find((d: any) => d.model === accuracyPick.model).supportSource}>Current developer listing</a> · Historical price: {money(accuracyPick.priceUSD)}</div>
        </div>
        <div class="rflow"><span class="n">±0.01</span><br /><span class="u">mL accuracy</span></div>
        <div class="rbuy"><a class="aff" href={buy(accuracyPick)} target="_blank" rel="sponsored nofollow noopener">Check price at {retailerName(accuracyPick.retailers)} ↗ <small>(paid link)</small></a></div>
      </div>
    </div>
  </section>

  <section class="container" style="padding-top:8px;">
    <h2>Not what they look like on the spec sheet</h2>
    <p style="color:var(--muted);max-width:68ch;">Two controller-dependent units and one model with unverified current availability. Check the exact version before buying.</p>
    <div class="tablewrap" tabindex="0" role="region" aria-label="Comparison table, scroll for all columns">
      <table class="specs">
        <thead><tr><th>Product</th><th>Recorded price</th><th>What it actually is</th><th></th></tr></thead>
        <tbody>
          {notStandalone.map((g) => (
            <tr>
              <td><strong>{g.brand}</strong> {g.model}</td>
              <td>{money(g.priceUSD)}</td>
              <td style="color:var(--muted)">{g.note} <a href={g.specSource || g.priceSource}>Source</a></td>
              <td><a class="aff aff-sm" href={buyGap(g)} target="_blank" rel="sponsored nofollow noopener">Check price at Amazon ↗ <small>(paid link)</small></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container prose" style="padding-top:24px;">
    <h2>What about kalkwasser?</h2>
    <p>{data.kalkwasserNotes} <a href={data.kalkwasserSource}>Seachem: clear solution only</a>. Read about settled reservoirs, optional reactors and metered dosing: <a href={url('/guides/kalkwasser-dosing')}>our kalkwasser dosing guide →</a></p>

    <h2>What about nitrate and phosphate?</h2>
    <p>A pump used for carbon dosing must be compatible with the chosen liquid and follow that product's instructions; do not assume every pump or tube material suits every additive. That's a nutrient-export method, completely unrelated to the Alk/Ca/Mg chemistry the rest of this page covers. See <a href={url('/guides/carbon-dosing')}>our carbon dosing guide →</a> for the method's limits and bacterial-bloom risk.</p>

    <h2>FAQ</h2>
    {faqs.map((f) => (
      <>
        <h3 style="font-size:1.05rem;">{f.q}</h3>
        <p style="color:var(--muted)">{f.a}</p>
      </>
    ))}
  </section>

  <section class="container">
    <EmailCapture />
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<style>
  .tablewrap { overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  table.specs { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 640px; }
  table.specs th { text-align: left; font-family: var(--font-display); font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding: 12px 14px; border-bottom: 2px solid var(--line); }
  table.specs td { padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
  table.specs tr:last-child td { border-bottom: none; }
  .aff-sm { padding: 7px 12px; font-size: .8rem; }
</style>
