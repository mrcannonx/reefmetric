---
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { url } from '../../utils/url';
import { SITE } from '../../consts';
import { goHref, retailerName } from '../../data/affiliate-config';
import wmData from '../../data/wavemakers.json';

interface WM {
  brand: string; model: string; priceUSD: number; maxFlowGPH: number; watts: number;
  tankRangeGal: string | null; mountType: string; controller: string;
  retailers?: string[]; source: string; imageUrl?: string | null;
}
const data = wmData as any;
const wms = (data.wavemakers as WM[]).slice().sort(
  (a, b) => (a.priceUSD / a.maxFlowGPH) - (b.priceUSD / b.maxFlowGPH)
);
const dataDate = data.generated as string;

const slug = (w: { brand: string; model: string }) =>
  `${w.brand}-${w.model}`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const money = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const per1k = (w: WM) => (w.priceUSD / w.maxFlowGPH) * 1000;
const buy = (w: WM) => goHref(w.retailers || [], `${w.brand} ${w.model} wavemaker`, w.source);
const byModel = (m: string) => (data.wavemakers as WM[]).find((w) => w.model.includes(m))!;

interface Pick { badge: string; why: string; w: WM; }
const picks: Pick[] = [
  {
    badge: 'Best overall',
    why: `A compact controllable option. Compare its recorded maximum flow, mounting limits, and control method with your tank; this pick does not imply a measured reliability advantage.`,
    w: byModel('Nero 5'),
  },
  {
    badge: 'Best for large tanks',
    why: `Gyre-style flow for a long tank. The table compares its recorded maximum output and price; leave room to remove the rotor for cleaning.`,
    w: byModel('XF350'),
  },
  {
    badge: 'The premium default',
    why: `Compare the VorTech design and control features with the space around your tank. Check glass thickness, side clearance, and the exact controller supplied before buying.`,
    w: byModel('MP40'),
  },
  {
    badge: 'Best budget',
    why: `The lowest recorded cost per maximum GPH in this dataset. That figure measures purchase cost against a rating; it does not measure noise, reliability, or output in your tank.`,
    w: byModel('SLW-10'),
  },
];

// Sub-category deep dives. Every figure below is derived from the dataset, never typed by hand,
// so a price refresh can't leave the prose asserting a stale number.
const slw = byModel('SLW-10');
const nero3 = byModel('Nero 3');
const xf350 = byModel('XF350');
const xf330 = byModel('XF330');
const twoSlwPrice = slw.priceUSD * 2;
const twoSlwFlow = slw.maxFlowGPH * 2;
// The two-cheap-pumps case only holds while a pair genuinely undercuts the step-up on both
// price and flow. If a price move ever breaks that, the paragraph hides itself rather than lying.
const twoSlwBeatsNero3 = twoSlwPrice < nero3.priceUSD && twoSlwFlow > nero3.maxFlowGPH;
// Gap to the runner-up on cost-per-flow. Read off the sorted list rather than a named model, so
// this can never drift into comparing against whichever pump happened to be second when written.
const runnerUp = wms[1];

const pageURL = new URL(url('/reviews/best-wavemakers'), SITE.url).href;
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Reef Wavemakers & Powerheads',
  numberOfItems: wms.length,
  itemListElement: wms.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: `${w.brand} ${w.model}`, url: `${pageURL}#${slug(w)}` })),
};
const faqs = [
  {
    q: 'How much flow do I actually need?',
    a: `A common starting range for reef circulation is 20–40× display volume per hour, adjusted for coral type and the flow at the coral. Your return pump counts toward the total. Our flow calculator does the math for your tank and coral type, then shows which of these pumps close the gap.`,
  },
  {
    q: 'One big wavemaker or two smaller ones?',
    a: `Two pumps can give more placement options and keep some circulation running while one is cleaned. The best arrangement depends on tank shape, rockwork, coral placement, and adjustable output. Watch the tank for dead zones and direct jets hitting coral.`,
  },
  {
    q: 'Why do app-controlled pumps keep failing to connect?',
    a: `Check the exact controller and its setup instructions. Wi-Fi and Bluetooth are different connection methods; a phone seeing the home network does not prove it can pair with every pump. Follow the vendor troubleshooting steps before resetting equipment.`,
  },
  {
    q: 'Are the manufacturer GPH ratings real?',
    a: `They are published maximum ratings, not typical output — real-world flow falls with wave modes (which pulse below max by design), biofilm and coralline buildup, and age. That's one more reason to size toward the top of your target band rather than buying exactly the minimum.`,
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const headline = "Best reef wavemakers — ranked by what flow actually costs";
---
<Base
  headline={headline}
  title="Best Reef Wavemakers (2026)"
  description="Compare reef wavemakers by cost per GPH, flow pattern, and published specs. See budget, gyre, and premium options with sizing limits."
  breadcrumbs={[{ name: 'Reviews', href: '/reviews' }, { name: 'Best Wavemakers', href: '/reviews/best-wavemakers' }]}
>
  <section class="container tool-wrap prose">
    <p class="eyebrow" style="color:var(--brand-2)">Reviews · Wavemakers</p>
    <h1>{headline}</h1>
    <p class="lede-dark">We compare <strong>recorded price per manufacturer-rated maximum GPH</strong>, then show control and mounting details. This is a sizing and cost comparison; we have not measured reliability, sound levels, or installed flow. Start with <a href={url('/tools/flow-calculator')}>the flow calculator</a> to get your GPH target; this page is what to buy to hit it.</p>
    <Disclosure />
    <p class="rnote" style="margin-top:0">Specs and prices from manufacturer and retailer pages on {dataDate} (each row links its source). Flow figures are manufacturer maximum ratings, not measured output. Recorded prices are dated, and no service-life estimate or failure rate is claimed. <a href={url('/how-we-rate')}>Full methodology →</a></p>
  </section>

  <section class="container" style="padding-top:8px;padding-bottom:16px;">
    <h2>The picks</h2>
    <p class="rnote" style="margin-top:0">Shopping a sub-category? Jump to <a href="#best-budget-wavemaker">the best budget wavemaker</a> or <a href="#best-gyre-wavemaker">the best gyre wavemaker</a>.</p>
    <div class="results">
      {picks.map((p, idx) => (
        <div id={`${slug(p.w)}-pick`} class={`rcard ${idx === 0 ? 'win' : ''}`}>
          {p.w.imageUrl && (
            <div class="rthumb">
              <img src={p.w.imageUrl} alt={`${p.w.brand} ${p.w.model}`} loading="lazy" decoding="async" width="64" height="64" onerror="this.parentElement.style.display='none'" />
            </div>
          )}
          <div class="rmain">
            <div class="rname">{p.w.brand} {p.w.model} <span class={idx === 0 ? 'pill-win' : 'rbadge'}>{p.badge}</span></div>
            <div class="rmeta">{p.why}</div>
            <div class="rmeta">{p.w.maxFlowGPH.toLocaleString()} GPH max · {p.w.watts}W · {p.w.controller}</div>
          </div>
          <div class="rflow"><span class="n">${per1k(p.w).toFixed(0)}</span><br /><span class="u">per 1k GPH</span></div>
          <div class="rbuy"><a class="aff" href={buy(p.w)} target="_blank" rel="sponsored nofollow noopener">{money(p.w.priceUSD)} at {retailerName(p.w.retailers)} (paid link) ↗</a></div>
        </div>
      ))}
    </div>
  </section>

  <section id="best-budget-wavemaker" class="container prose" style="padding-top:24px;">
    <h2>Best budget wavemaker</h2>
    <p>The <strong>{slw.brand} {slw.model}</strong>, at {money(slw.priceUSD)}. <strong>${per1k(slw).toFixed(0)} per 1,000 rated GPH</strong> is the lowest recorded price-to-rating ratio on this page; the next model in the sorted dataset is the {runnerUp.brand} {runnerUp.model} at ${per1k(runnerUp).toFixed(0)}.</p>
    <p>The recorded controller is {slw.controller}. Read the setup and cleaning instructions, and check that the mount suits your glass thickness. Price per rated GPH cannot predict service life.</p>
    {twoSlwBeatsNero3 && (
      <p><strong>The math most budget buyers miss:</strong> two of these run {money(twoSlwPrice)} for {twoSlwFlow.toLocaleString()} GPH — still less money than one {nero3.brand} {nero3.model} at {money(nero3.priceUSD)}, and more flow than its {nero3.maxFlowGPH.toLocaleString()} GPH. Two pumps can give more placement options, but their combined maximum rating is not the flow measured at a coral.</p>
    )}
    <p>Step up to the <strong>{nero3.brand} {nero3.model}</strong> at {money(nero3.priceUSD)} if you prefer its control features and mounting design. No longer-life claim is supported by this comparison.</p>
  </section>

  <section id="best-gyre-wavemaker" class="container prose" style="padding-top:24px;">
    <h2>Best gyre wavemaker</h2>
    <p>The <strong>{xf350.brand} {xf350.model}</strong> at {money(xf350.priceUSD)} — unless your tank is small, in which case skip to the XF330 below.</p>
    <p>A gyre pump is a different shape of flow, not just a stronger powerhead. A long crossflow rotor pushes a wide <em>sheet</em> of water down the length of the tank and back along the bottom, instead of firing a cone-shaped jet from one spot. That's why people reach for them on long tanks with dead corners a traditional powerhead can't clear.</p>
    <p><strong>Which gyre:</strong> the two Maxspect Gyres here are priced strangely close for how different they are. The {xf350.model.replace(' Cloud Edition', '')} moves {xf350.maxFlowGPH.toLocaleString()} GPH for {money(xf350.priceUSD)}; the {xf330.model.replace(' Cloud Edition', '')} moves {xf330.maxFlowGPH.toLocaleString()} GPH for {money(xf330.priceUSD)}. That's {(xf350.maxFlowGPH / xf330.maxFlowGPH).toFixed(1)}× the flow for {money(xf350.priceUSD - xf330.priceUSD)} more, which drops the cost per 1,000 GPH from <strong>${per1k(xf330).toFixed(0)}</strong> to <strong>${per1k(xf350).toFixed(0)}</strong> — close to half.</p>
    <p><strong>The exception, and it matters:</strong> Maxspect rates the {xf350.model.replace(' Cloud Edition', '')} for {xf350.tankRangeGal} and the {xf330.model.replace(' Cloud Edition', '')} for {xf330.tankRangeGal}. Use those manufacturer ranges as a starting point, then consider tank length, coral placement, sand movement, and adjustable output. The lowest cost per GPH can still be a poor fit for your tank.</p>
    <p><strong>Before buying:</strong> leave enough space to remove and clean the rotors. Follow the manufacturer maintenance schedule. No sound-level or monthly-cleaning comparison was measured for this guide.</p>
  </section>

  <section class="container" style="padding-top:8px;">
    <h2>Every pump, ranked by cost per GPH</h2>
    <div class="tablewrap" tabindex="0" role="region" aria-label="Equipment comparison, scroll for all columns">
      <table class="specs">
        <thead><tr><th>#</th><th>Pump</th><th>Max flow</th><th>$/1k GPH</th><th>Watts</th><th>Control</th><th>Mount / tank range</th><th>Price</th></tr></thead>
        <tbody>
          {wms.map((w, i) => (
            <tr id={slug(w)}>
              <td>{i + 1}</td>
              <td><strong>{w.brand}</strong> {w.model}<br /><a href={w.source} target="_blank" rel="noopener">Listing and specs</a></td>
              <td>{w.maxFlowGPH.toLocaleString()} GPH</td>
              <td><strong>${per1k(w).toFixed(0)}</strong></td>
              <td>{w.watts}W</td>
              <td style="color:var(--muted)">{w.controller}</td>
              <td style="color:var(--muted)">{w.mountType} · {w.tankRangeGal || 'Tank range not recorded'}</td>
              <td><a class="aff aff-sm" href={buy(w)} target="_blank" rel="sponsored nofollow noopener">{money(w.priceUSD)} (paid link) ↗</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="rnote">Cost per 1,000 GPH = price ÷ manufacturer max flow × 1,000 — a value metric, not a quality score. It does not compare service life. Check tank fit, control, cleaning access, and current retailer pricing before choosing.</p>
  </section>

  <section class="container prose" style="padding-top:24px;">
    <h2>FAQ</h2>
    {faqs.map((f) => (
      <>
        <h3 style="font-size:1.05rem;">{f.q}</h3>
        <p style="color:var(--muted)">{f.a}</p>
      </>
    ))}
    <p><a href={url('/tools/flow-calculator')} class="inlinecta">→ Get your tank's flow target, then come back for the pump</a></p>
  </section>

  <section class="container">
    <EmailCapture />
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<style>
  .tablewrap { overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  table.specs { width: 100%; border-collapse: collapse; font-size: .92rem; min-width: 760px; }
  table.specs th { text-align: left; font-family: var(--font-display); font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding: 12px 14px; border-bottom: 2px solid var(--line); }
  table.specs td { padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
  table.specs tr:last-child td { border-bottom: none; }
  .aff-sm { padding: 7px 12px; font-size: .8rem; }
  .inlinecta { display:inline-block; font-family:var(--font-display); font-weight:700; color:var(--brand-2); }
</style>
