---
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
import CardArt from '../components/CardArt.astro';
import { url } from '../utils/url';
import { recommend, type Pump } from '../utils/pump-calc';
import pumpData from '../data/pumps.json';
import skimmerData from '../data/skimmers.json';
import saltData from '../data/salts.json';
import controllerData from '../data/controllers.json';
import lightData from '../data/lights.json';

// Hero proof stat, computed live from the dataset at build time so it can't go stale or look
// cherry-picked. Same reference plumbing as the 75-gallon class on the return-pump review page.
const pumps = (pumpData as any).pumps as Pump[];
const REF_PLUMBING = { displayGallons: 75, turnover: 7, staticHeadFt: 4.5, pipeIdInches: 1.029, pipeLengthFt: 10, elbows: 4 };
const { results: pumpResults } = recommend(REF_PLUMBING, pumps);
const ratios = pumpResults.filter((r) => r.deliveredGPH > 0).map((r) => r.deliveredGPH / r.pump.maxFlowGPH);
const avgDeliveredPct = Math.round((ratios.reduce((a, b) => a + b, 0) / ratios.length) * 100);

const datasetCounts = {
  pumps: pumps.length,
  skimmers: (skimmerData as any).skimmers.length,
  salts: (saltData as any).salts.length,
  controllerKits: (controllerData as any).ecosystems.reduce((n: number, e: any) => n + e.kits.length, 0),
  lights: (lightData as any).lights.length,
};

const tools = [
  { name: 'Return Pump Calculator', desc: `Estimated flow at your actual head, using pump curves and plumbing inputs. ${datasetCounts.pumps} pumps, ranked.`, tag: 'Calculator · Live', href: '/tools/return-pump-calculator', art: 'calc-pump' },
  { name: 'Protein Skimmer Sizer', desc: 'Which skimmers actually fit your tank once we derate the optimistic ratings for your bioload.', tag: 'Calculator · Live', href: '/tools/protein-skimmer-calculator', art: 'calc-skimmer' },
  { name: 'Reef Build Cost Estimator', desc: 'Itemized up-front + monthly running cost for any tank size and tier.', tag: 'Calculator · Live', href: '/tools/reef-build-cost-calculator', art: 'calc-cost' },
];
const clusters = [
  { name: 'Protein Skimmers', desc: 'By tank size, by budget, by real bioload rating — not guesses.', href: '/reviews/best-protein-skimmers', art: 'skimmer' },
  { name: 'Return Pumps & Flow', desc: 'DC vs AC, turnover math, and real delivered flow at your head.', href: '/reviews/best-return-pumps', art: 'pump' },
  { name: 'Salt & Consumables', desc: 'Every major salt mix ranked by true cost per mixed gallon.', href: '/reviews/best-reef-salt-mix', art: 'salt' },
  { name: 'Controllers', desc: 'Apex vs GHL vs Hydros, plus budget/DIY picks and why ReefKeeper is off the list.', href: '/compare/apex-vs-hydros-vs-ghl', art: 'controller' },
  { name: 'Reef Lighting', desc: 'Only 4 of 11 popular fixtures have real PAR data behind them — ranked, plus a transparency scorecard on the rest.', href: '/reviews/best-reef-led-lighting', art: 'light' },
  { name: 'Dosing Pumps', desc: "Ranked, plus which well-known doser can't run at all without a controller you probably don't already own.", href: '/reviews/best-reef-dosing-pumps', art: 'doser' },
  { name: 'Wavemakers', desc: 'Ranked by real dollars per GPH — with each line\'s documented reliability record next to the price.', href: '/reviews/best-wavemakers', art: 'wavemaker' },
  { name: 'Test Kits', desc: 'Hanna vs Salifert vs Red Sea on the specs they publish but nobody compares — accuracy, resolution, cost per test.', href: '/reviews/best-reef-test-kits', art: 'testkit' },
  { name: 'Setup Guides by Tank Size', desc: '30, 40B, 55, 75, and 120 gallon — the full build, sized piece by piece, with honest costs.', href: '/guides', art: 'tank' },
];
---
<Base title="Saltwater Aquarium Gear: Reviews & Tools">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Measured, not guessed</p>
        <h1>Saltwater aquarium gear, with the math shown.</h1>
        <p class="lede">Data-driven reviews, side-by-side comparison databases, and calculators for saltwater aquarium gear — so you buy the right skimmer, pump, or light the first time.</p>
        <p style="margin-top:26px;">
          <a href={url('/tools')} class="btn">Explore the tools</a>
          <a href={url('/guides')} class="btn btn-ghost">Read the guides</a>
        </p>
      </div>
      <a href={url('/tools/return-pump-calculator')} class="hero-proof">
        <p class="hero-proof-eyebrow">Real number, not marketing</p>
        <div class="hero-proof-stat">{avgDeliveredPct}<span>%</span></div>
        <p class="hero-proof-caption">of box-rated GPH is the average modeled flow in our reference 75-gallon setup. This is a calculation from the pump dataset, not a bench measurement.</p>
        <p class="hero-proof-cta">See your pump's real number →</p>
        <p class="hero-proof-scale">{datasetCounts.pumps} pumps · {datasetCounts.skimmers} skimmers · {datasetCounts.salts} salts · {datasetCounts.controllerKits} controller kits · {datasetCounts.lights} lights rated</p>
        <p class="hero-proof-scale">Reference: {REF_PLUMBING.staticHeadFt} ft lift, {REF_PLUMBING.pipeLengthFt} ft pipe, {REF_PLUMBING.pipeIdInches} in internal diameter, {REF_PLUMBING.elbows} elbows. Pumps with zero modeled flow are excluded from this average.</p>
      </a>
    </div>
  </section>

  <section class="container">
    <p class="eyebrow" style="color:var(--brand-2)">The tools</p>
    <h2>Answers you can’t get from a listicle.</h2>
    <p>Start with the <a href={url('/tools/return-pump-calculator')}>return pump calculator</a> for your plumbing, then compare the <a href={url('/reviews/best-protein-skimmers')}>protein skimmer rankings</a> against your tank's bioload before buying.</p>
    <p>Find the right <a href={url('/tools')}>reef tank calculator</a> for the job: the <a href={url('/tools/reef-dosing-calculator')}>reef calculator for alkalinity, calcium and magnesium</a>, <a href={url('/tools/protein-skimmer-calculator')}>reef protein skimmer sizing</a>, <a href={url('/tools/reef-build-cost-calculator') + '#aquarium-electricity-cost-calculator'}>aquarium electricity cost</a>, or <a href={url('/tools/salt-cost-calculator')}>Instant Ocean salt cost</a>. Each shows the inputs behind the answer.</p>
    <div class="grid cols-3" style="margin-top:26px;">
      {tools.map((t) => (t as any).href ? (
        <a class="card cardlink" href={url((t as any).href)}>
          <CardArt kind={t.art} />
          <span class="pill">{t.tag}</span>
          <h3>{t.name}</h3>
          <p style="color:var(--muted)">{t.desc}</p>
        </a>
      ) : (
        <div class="card">
          <CardArt kind={t.art} />
          <span class="pill">{t.tag}</span>
          <h3>{t.name}</h3>
          <p style="color:var(--muted)">{t.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container">
    <p class="eyebrow" style="color:var(--brand-2)">Gear, organized by your tank</p>
    <h2>Start with your setup.</h2>
    <p>For return pumps, compare the <a href={url('/reviews/best-return-pumps')}>best return pump for your reef tank size</a> and the <a href={url('/guides/dc-vs-ac-return-pumps')}>AC pump vs DC pump trade-offs</a>. For daily care, compare <a href={url('/reviews/best-reef-dosing-pumps')}>reef dosing pumps</a> and <a href={url('/reviews/best-ato')}>the best ATO options for reef tanks</a>.</p>
    <div class="grid cols-3" style="margin-top:26px;">
      {clusters.map((c) => (
        <a class="card cardlink" href={url(c.href)}>
          <CardArt kind={c.art} />
          <h3>{c.name}</h3>
          <p style="color:var(--muted)">{c.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container">
    <h2>Planning a new reef or changing a routine?</h2>
    <p>The <a href={url('/guides/30-gallon-reef-tank-setup')}>30-gallon setup guide</a> starts with AIO and hang-on filtration; the <a href={url('/guides/120-gallon-reef-tank-setup')}>120-gallon setup guide</a> covers the wider footprint, sump, and water storage. Use the <a href={url('/tools/reef-build-cost-calculator')}>whole-build budget</a> before buying. For nutrient export on an established tank, read <a href={url('/guides/carbon-dosing')}>carbon dosing and its oxygen risks</a>. The <a href={url('/guides')}>guides hub</a> separates setup, mineral dosing, and nutrient export.</p>
    <EmailCapture />
  </section>
</Base>
