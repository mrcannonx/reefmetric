---
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { url } from '../../utils/url';
import { parAtHeight, type Light } from '../../utils/light-calc';
import lightData from '../../data/lights.json';

const lights = lightData.lights as (Light & { measurementContext?: string })[];
const first = lights[0];
const firstPoint = first.parCurve[0];
const initial = parAtHeight(first, firstPoint.heightIn);
const headline = 'Reef PAR Calculator';
---
<Base
  headline={headline}
  title="Reef PAR Calculator: Published Light Data"
  description="Explore reef light PAR points and interpolate within one source curve. Check test conditions and unknowns before choosing a light or mounting height."
  breadcrumbs={[{ name: 'Tools', href: '/tools' }, { name: 'Reef PAR Calculator', href: '/tools/reef-par-calculator' }]}
>
  <section class="container tool-wrap">
    <p class="eyebrow" style="color:var(--brand-2)">Calculator</p>
    <h1>{headline}</h1>
    <p class="lede-dark">Explore a fixture’s published PAR measurements. Each source uses its own test setup: a dry bench distance, water depth, and mounting height are different measurements. This tool keeps those conditions separate. It cannot predict PAR at your coral from mounting height and depth alone.</p>
    <div class="calc card">
      <form id="par-form" class="calc-grid" autocomplete="off">
        <label>Fixture and source
          <select id="parFixture">
            {lights.map((light, i) => <option value={i}>{light.brand} {light.model}</option>)}
          </select>
        </label>
        <label>Source distance or depth (inches)
          <input id="parDistance" type="number" min="0" step="any" value={firstPoint.heightIn} />
        </label>
      </form>
      <div id="par-summary" class="summary">Published point: {initial.par} PAR at {firstPoint.heightIn} inches in this source’s test setup.</div>
    </div>
    <Disclosure />
    <div id="par-results" class="results"></div>
    <p class="rnote" id="par-gap">Measure with a PAR meter at the coral’s location before setting intensity.</p>
  </section>
  <section class="container prose">
    <h2>How the calculation works</h2>
    <p>PAR describes light available for photosynthesis; the numbers here are PPFD in μmol/m²/s. Within one source’s measured range, this calculator uses a straight line between adjacent points. It returns “unknown” outside that range. With only one source point, only that exact coordinate has a known value. Interpolation is an estimate, not a new measurement.</p>
    <h2>Why the fixtures are not ranked together</h2>
    <p>A dry bench reading and a submerged reading cannot be compared as if they were taken in the same aquarium. Spectrum, intensity, water clarity, surface movement, and where the sensor sits all affect the result. Adding mount height to coral depth does not convert one test setup into another. A PAR meter in your own tank answers the question this source table cannot.</p>
    <h2>Before choosing a light</h2>
    <p>Read the source conditions shown with your selected fixture. Check the maker’s coverage guidance, then compare the <a href={url('/reviews/best-reef-led-lighting')}>reef lighting guide</a>. Acclimate corals to a lighting change and check the light where each coral will sit.</p>
    <h2>Published source points</h2>
    <p>These are the recorded data points used by the tool. Source links and conditions appear with each selection. Dataset date: {lightData.generated}; sources can change.</p>
    {lights.map((light) => <div>
      <h3>{light.brand} {light.model}</h3>
      <p>{light.measurementContext || 'Read the linked source for the measurement setup.'} <a href={light.parSource} target="_blank" rel="noopener">PAR source ↗</a></p>
      <table class="breakdown"><thead><tr><th>Source coordinate (inches)</th><th>Recorded PAR</th></tr></thead><tbody>{light.parCurve.map((point) => <tr><td>{point.heightIn}</td><td>{point.par}</td></tr>)}</tbody></table>
    </div>)}
  </section>
  <section class="container"><EmailCapture /></section>
</Base>
<script>
  import { parAtHeight, type Light } from '../../utils/light-calc';
  import { validateCalcInputs } from '../../utils/input-calc';
  import data from '../../data/lights.json';
  const lights = data.lights as (Light & { measurementContext?: string })[];
  const el = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
  const esc = (s: string) => String(s).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  function render() {
    if (!validateCalcInputs('#par-form input[type="number"]', 'par-summary', ['par-results'])) return;
    const light = lights[Number(el('parFixture').value)];
    const distance = Number(el('parDistance').value);
    const summary = document.getElementById('par-summary');
    const results = document.getElementById('par-results');
    if (!summary || !results || !light) return;
    const { par, exact } = parAtHeight(light, distance);
    summary.textContent = par === null
      ? `PAR is unknown at ${distance} inches in this source. No extrapolation is made.`
      : `${exact ? 'Published point' : 'Interpolated estimate'}: ${Math.round(par)} PAR at ${distance} inches in this source’s test setup.`;
    const points = light.parCurve.map((p) => `${p.heightIn}″: ${p.par} PAR`).join(' · ');
    results.innerHTML = `<div class="rcard"><div class="rmain"><div class="rname">${esc(light.brand)} ${esc(light.model)}</div><p class="rmeta">${esc(light.measurementContext || 'Read the source for its test setup; conditions are not interchangeable.')}</p><p class="rmeta">Recorded points: ${esc(points)}</p><a href="${esc(light.parSource || '')}" target="_blank" rel="noopener">Read the PAR source ↗</a></div></div>`;
  }
  el('parFixture').addEventListener('input', () => {
    const light = lights[Number(el('parFixture').value)];
    if (light) el('parDistance').value = String(light.parCurve[0].heightIn);
    render();
  });
  el('parDistance').addEventListener('input', render);
  render();
</script>
